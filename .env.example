SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
ORIGIN=http://localhost:5173
BODY_SIZE_LIMIT=524288

# Optional OpenAI provider cost sync.
# OPENAI_ADMIN_KEY=

# Optional Anthropic provider cost sync.
# Requires an Anthropic organization Admin API key.
# ANTHROPIC_ADMIN_KEY=

# Optional xAI provider cost sync.
# Requires an xAI management key with Billing read access.
# XAI_MANAGEMENT_KEY=

# PROVIDER_COST_CACHE_MINUTES=60
